# LMS backend - example environment file.
#
# Copy this file to ".env" and fill in your own values:
#     cp .env.example .env
# NEVER commit the real ".env" file or real credentials.
#
# Values are also read directly from the environment; real environment
# variables override what is written here.

# ---- HTTP server ----
LMS_SERVER_HOST=127.0.0.1
LMS_SERVER_PORT=8080
# Origin allowed to call the API. For local Vite dev use http://localhost:5173
# For production use your Vercel URL, e.g. https://your-app.vercel.app
LMS_CORS_ALLOWED_ORIGIN=http://localhost:5173

# ---- Authentication sessions (Milestone 3+) ----
# Absolute lifetime of a login session, in seconds (12h default).
LMS_SESSION_TTL_SECONDS=43200
# Idle timeout: a session expires after this long without activity (30m default).
LMS_SESSION_TTL_IDLE_SECONDS=1800
# Add the 'Secure' attribute to the session cookie. Keep "0" while testing over
# plain http; set to "1" behind TLS only.
LMS_COOKIE_SECURE=0

# ---- Google Books (optional ISBN metadata lookup) ----
# Used by GET /api/books/lookup/:isbn to enrich bulk imports and the book form.
# Keep this secret server-side; never expose it to the React bundle.
LMS_GOOGLE_BOOKS_API_KEY=


# ---- Supabase PostgreSQL (used from Milestone 2 onward) ----
# Find these in the Supabase dashboard: Project Settings -> Database.
LMS_DB_HOST=db.your-project-ref.supabase.co
LMS_DB_PORT=5432
LMS_DB_NAME=postgres
LMS_DB_USER=postgres.your-project-ref
LMS_DB_PASSWORD=your-database-password
LMS_DB_SSLMODE=require
